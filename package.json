{
  "name": "wilhalla",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "imports": {
    "#/*": "./src/*"
  },
  "pnpm": {
    "overrides": {
      "@tanstack/start-server-core": "1.169.8"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "msw"
    ]
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "node scripts/start-server.mjs",
    "preview": "pnpm run start",
    "test": "vitest run --passWithNoTests",
    "sync-gallery-images": "scripts/sync-gallery-images.sh",
    "generate-map-hover-overlays": "scripts/generate-map-hover-overlays.sh",
    "generate-map-caption-glows": "scripts/generate-map-caption-glows.sh",
    "format": "biome format --write ./src",
    "check": "biome lint --write ./src"
  },
  "dependencies": {
    "@fontsource-variable/eb-garamond": "^5.2.7",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-devtools": "^0.10.5",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "1.170.10",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tanstack/react-start": "1.168.18",
    "@tanstack/router-core": "1.171.8",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "nitro": "3.0.260522-beta",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@tanstack/devtools-vite": "^0.7.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^29.1.1",
    "shadcn": "^4.10.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
