{
  "name": "wilhalla",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "imports": {
    "#/*": "./src/*"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"],
    "ignoredBuiltDependencies": ["msw"]
  },
  "scripts": {
    "dev": "vite dev --port 3000",
